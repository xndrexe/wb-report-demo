# Токен API кабинета продавца WB: Настройки → Доступ к API, категории «Статистика»,
# «Аналитика» и «Продвижение», режим «Только на чтение»
WB_TOKEN=
# За сколько дней строить отчёт
DAYS=30
# Площадка: wb или ozon (флаг --market важнее)
MARKETPLACE=wb
# Куда сохранить Excel; по умолчанию out/wb_report.xlsx или out/ozon_report.xlsx
EXCEL_PATH=

# Ozon Seller API: кабинет продавца → Настройки → Seller API, Client ID и ключ
OZON_CLIENT_ID=
OZON_API_KEY=

# Google Таблица (необязательно): id из адреса таблицы и путь к ключу сервисного аккаунта
GSHEET_ID=
GOOGLE_CREDENTIALS=
